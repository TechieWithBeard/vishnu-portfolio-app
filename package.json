    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitejs/plugin-react": "^5.2.0",
