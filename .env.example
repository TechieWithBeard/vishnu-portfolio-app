# ==============================================================================
# Vishnu Portfolio - Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# ==============================================================================

# 1. API Server Port (Default: 3000)
PORT=3000

# 2. Supabase Cloud Configuration
# Find these in your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Service Role Key (for admin full access bypass)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
